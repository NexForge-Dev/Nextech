# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3300
# Supabase project (local: npx supabase start → API_URL / ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55821
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts affiliate network credentials.
NETWORK_CREDENTIALS_KEY=
# Shared secret for Vercel Cron routes (/api/cron/*)
CRON_SECRET=
