# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3300
# Supabase project (local: npx supabase start → API_URL / ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55821
# Either the new publishable key (preferred) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts affiliate network credentials.
NETWORK_CREDENTIALS_KEY=
# Shared secret for Vercel Cron routes (/api/cron/*)
CRON_SECRET=
# Stripe (own store). Test keys for development: sk_test_… / pk_test_… — never commit live keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint /api/stripe/webhook (stripe listen prints one locally).
# Checkout stays closed without it: nothing could confirm a payment.
STRIPE_WEBHOOK_SECRET=
# Transactional email (Resend). Without these, customers get no e-mail at all (the order page still
# works) and owner alerts appear only in the admin home and in the logs.
RESEND_API_KEY=
EMAIL_FROM="NEXTECH <pedidos@seu-dominio.com.br>"
# Where owner alerts go: new orders, disputes, refunds that failed or need manual action
OWNER_ALERT_EMAIL=
# NexForge management panel (internal product metrics). All three empty = no-op.
# Pseudonymous ids and fixed codes only — never names, e-mails, CPF, addresses or order data.
NEXFORGE_ENDPOINT=
NEXFORGE_INGEST_KEY=
NEXFORGE_PSEUDONYM_SECRET=
